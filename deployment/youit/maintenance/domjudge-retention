#!/bin/bash
set -euo pipefail

# A judgetask DELETE cascades into judging_run and judging_run_output.
# Reporting-only until a separately approved archival policy exists.
for arg in "$@"; do
    case "$arg" in
        --dry-run) ;;
        *) echo "Database deletion is disabled; only --dry-run is supported." >&2; exit 2 ;;
    esac
done
days=${DOMJUDGE_RETENTION_DAYS:-30}
batch=${DOMJUDGE_RETENTION_BATCH_SIZE:-2000}
[[ $days =~ ^[1-9][0-9]*$ && $batch =~ ^[1-9][0-9]*$ ]] || {
    echo "Retention settings must be positive integers" >&2; exit 2;
}
exec 9>/run/domjudge-maintenance.lock
flock -n 9 || { echo "Another maintenance operation is active; exiting"; exit 0; }

docker exec -i mariadb sh -c \
    'MYSQL_PWD="$MYSQL_PASSWORD" exec mariadb --batch -u "$MYSQL_USER" "$MYSQL_DATABASE"' <<SQL
SET SESSION max_statement_time=5;
SET TRANSACTION READ ONLY;
SELECT jt.judgetaskid, j.judgingid, j.endtime
FROM judgetask jt
INNER JOIN judging j ON j.judgingid = jt.jobid
WHERE jt.type = 'judging_run' AND jt.valid = 0
  AND j.endtime IS NOT NULL
  AND j.endtime < UNIX_TIMESTAMP() - ($days * 86400)
ORDER BY jt.judgetaskid LIMIT $batch;
SQL
echo "report_only=true deleted_tasks=0 sample_limit=$batch retention_days=$days"
