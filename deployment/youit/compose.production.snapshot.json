          }
        },
        {
          "type": "bind",
          "source": "/root/domjudge-docker/overrides/judgehost/judgedaemon.main.php",
          "target": "/opt/domjudge/judgehost/lib/judge/judgedaemon.main.php",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ]
    },
    "mariadb": {
      "command": [
        "--max-connections=1000",
        "--default-time-zone=+03:00",
        "--innodb_snapshot_isolation=OFF",
        "--innodb-log-file-size=256M",
        "--innodb-buffer-pool-size=2G",
        "--max-allowed-packet=256M",
        "--tmpdir=/var/lib/mysql-tmp",
        "--innodb-compression-default=ON",
        "--innodb-compression-algorithm=zlib",
        "--innodb-compression-level=6"
      ],
      "container_name": "mariadb",
      "entrypoint": null,
      "environment": {
        "CONTAINER_TIMEZONE": "Europe/Moscow",
        "MYSQL_DATABASE": "domjudge",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD:?Set MYSQL_PASSWORD outside Git}",
        "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD:?Set MYSQL_ROOT_PASSWORD outside Git}",
        "MYSQL_USER": "domjudge",
        "TZ": "Europe/Moscow"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "mariadb-admin ping -h 127.0.0.1 -u root -p\"$$MYSQL_ROOT_PASSWORD\" --silent"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 10
      },
      "image": "mariadb@sha256:5b6a1eac15b85b981a61afb89aea2a22bf76b5f58809d05f0bcc13ab6ec44cb8",
      "networks": {
        "domjudge": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "192.168.0.250",
          "target": 3306,
          "published": "13306",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "db-data",
          "target": "/var/lib/mysql",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/mnt/domjudge-judgehost/mysql-tmp",
          "target": "/var/lib/mysql-tmp",
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/etc/localtime",
          "target": "/etc/localtime",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ]
    }
  },
  "volumes": {
    "db-data": {
      "name": "domjudge-docker_db-data",
      "external": true
    }
  }
}
