[Unit]
Description=Clean DOMjudge judgehost testcase cache
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=THRESHOLD_PERCENT=70
Environment=EMERGENCY_PERCENT=90
Environment=MAX_AGE_MINUTES=360
Environment=MIN_RECLAIM_BYTES=134217728
ExecStart=/usr/local/sbin/domjudge-clean-judgehost-cache
ExecStopPost=/usr/local/sbin/domjudge-clean-judgehost-cache --restore-only
TimeoutStopSec=210s
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
